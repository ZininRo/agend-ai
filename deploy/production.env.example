TTS_TIMEOUT_SEC=
TTS_VOICE=
TTS_EMOTION=
TTS_SPEED=
TTS_MAX_CHARS=

# Web Push
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=

# Google Calendar (OAuth)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_FRONTEND_RETURN_URL=
