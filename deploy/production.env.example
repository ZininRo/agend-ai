# Copy to .env on VPS; never commit or share actual .env.
APP_DOMAIN=agenda.example.com
BASIC_AUTH_USER=demo
# Generate with: docker run --rm caddy:2 caddy hash-password
# Escape $ as $$ when placing hash in .env for Compose.
BASIC_AUTH_HASH=REPLACE_WITH_CADDY_HASH
DB_USER=agendai
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
LLM_PROVIDER=yandexgpt
LLM_API_KEY=
LLM_FOLDER_ID=
LLM_MODEL=yandexgpt/latest
LLM_TIMEOUT_SEC=15
LLM_MAX_TOKENS=1000
STT_PROVIDER=speechkit
STT_API_KEY=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
# Contact address, not an SMTP sender. Use an address you control.
PUSH_SUBJECT=mailto:push@example.com
