<file path="src/test/java/com/example/agend_ai/service/llm/ModelOutputCleanerTest.java">
package com.example.agend_ai.service.llm;

import static org.assertj.core.api.Assertions.*;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;

class ModelOutputCleanerTest {
  private final ObjectMapper mapper = new ObjectMapper();

  private String clean(String raw) {
    return ModelOutputCleaner.clean(raw, mapper);
  }

  private JsonNode parsed(String raw) throws Exception {
    return new IntentValidator(mapper).parse(clean(raw));
  }

  @Test
  void extractsJsonFromMarkdownFenceAndChatter() throws Exception {
    JsonNode n =
        parsed(
            "Вот ответ:\n```json\n{\"intent\":\"list_items\",\"confidence\":0.9,\"slots\":{\"period_expr\":\"сегодня\"}}\n```");
    assertThat(n.get("intent").asText()).isEqualTo("list_items");
    assertThat(n.at("/slots/period_expr").asText()).isEqualTo("сегодня");
  }

  @Test
  void dropsEmptyNullAndPlaceholderSlots() throws Exception {
    JsonNode n =
        parsed(
            "{\"intent\":\"create_item\",\"confidence\":0.95,\"slots\":{\"item_type\":\"meeting\","
                + "\"title\":\"Встреча с командой\",\"date_expr\":\"завтра\",\"time_expr\":\"15:00\","
                + "\"deadline_expr\":\"\",\"place\":\"null\",\"query\":\"  \",\"type_filter\":null,\"answer\":\"None\"}}");
    assertThat(n.at("/slots").fieldNames()).toIterable()
        .containsExactlyInAnyOrder("item_type", "title", "date_expr", "time_expr");
  }

  @Test
  void numbersInSlotsAreNotSilentlyConvertedToStrings() {
    assertThatThrownBy(
            () ->
                parsed(
                    "{\"intent\":\"create_item\",\"confidence\":1,\"slots\":{\"title\":42}}"))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(
            () ->
                parsed(
                    "{\"intent\":\"create_item\",\"confidence\":1,\"slots\":{\"time_expr\":15}}"))
        .isInstanceOf(IllegalArgumentException.class);
  }

  @Test
  void trimsSpacesAroundSlotValues() throws Exception {
    JsonNode n =
        parsed("{\"intent\":\"create_item\",\"confidence\":0.9,\"slots\":{\"title\":\"  Позвонить Ивану \"}}");
    assertThat(n.at("/slots/title").asText()).isEqualTo("Позвонить Ивану");
  }

  @Test
  void normalizesIntentCaseAndPercentConfidence() throws Exception {
    JsonNode n = parsed("{\"intent\":\" List_Items \",\"confidence\":95,\"slots\":{}}");
    assertThat(n.get("intent").asText()).isEqualTo("list_items");
    assertThat(n.get("confidence").asDouble()).isEqualTo(0.95);
  }

  @Test
  void stillRejectsWhatIsReallyWrong() {
    ObjectMapper m = new ObjectMapper();
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"delete_all\",\"confidence\":1,\"slots\":{}}")))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"unknown\",\"confidence\":1,\"slots\":{},\"extra\":1}")))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"create_item\",\"confidence\":1,\"slots\":{\"item_type\":\"event\"}}")))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"unknown\",\"confidence\":250,\"slots\":{}}")))
        .isInstanceOf(IllegalArgumentException.class);
    // confidence=2 — не процент и не доля: отвергается, а не превращается в 0.02
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"create_item\",\"confidence\":2,\"slots\":{}}")))
        .isInstanceOf(IllegalArgumentException.class);
    assertThatThrownBy(() -> new IntentValidator(m).parse(clean("{\"intent\":\"unknown\",\"slots\":{}}")))
        .isInstanceOf(IllegalArgumentException.class);
  }

  @Test
  void nonJsonIsReturnedUntouchedSoValidatorFails() {
    assertThat(clean("Извините, не могу")).isEqualTo("Извините, не могу");
    assertThat(clean("")).isEqualTo("");
    assertThat(clean(null)).isNull();
    assertThatThrownBy(() -> new IntentValidator(mapper).parse(clean("Извините, не могу")))
        .isInstanceOf(IllegalArgumentException.class);
  }
}
</file>

<file path="src/test/java/com/example/agend_ai/service/llm/YandexGptClientTest.java">
package com.example.agend_ai.service.llm;

import static com.github.tomakehurst.wiremock.client.WireMock.*;
import static org.assertj.core.api.Assertions.*;

import com.example.agend_ai.api.error.*;
import com.example.agend_ai.config.LlmProperties;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.github.tomakehurst.wiremock.WireMockServer;
import org.junit.jupiter.api.*;

class YandexGptClientTest {
  private static final String PATH = "/foundationModels/v1/completion";
  private static final String OK =
      "{\"result\":{\"alternatives\":[{\"message\":{\"role\":\"assistant\",\"text\":\"{\\\"intent\\\":\\\"unknown\\\"}\"},"
          + "\"status\":\"ALTERNATIVE_STATUS_FINAL\"}]}}";

  private final ObjectMapper mapper = new ObjectMapper();
  private WireMockServer wire;

  @BeforeEach
  void start() {
    wire = new WireMockServer(0);
    wire.start();
  }

  @AfterEach
  void stop() {
    wire.stop();
  }

  private YandexGptClient client(String key, String folder, int timeoutSec) throws Exception {
    var props =
        new LlmProperties("yandexgpt", "yandexgpt/latest", key, folder, wire.baseUrl(), timeoutSec, 500);
    return new YandexGptClient(props, new IntentValidator(mapper));
  }

  @Test
  void firstRequestUsesSimplifiedJsonSchema() throws Exception {
    wire.stubFor(post(urlEqualTo(PATH)).willReturn(okJson(OK)));
    assertThat(client("k", "f", 5).generateStructuredJson("sys", "data")).isEqualTo("{\"intent\":\"unknown\"}");

    wire.verify(
        postRequestedFor(urlEqualTo(PATH))
            .withHeader("Authorization", equalTo("Api-Key k"))
            .withHeader("x-folder-id", equalTo("f"))
            .withRequestBody(matchingJsonPath("$.modelUri", equalTo("gpt://f/yandexgpt/latest"))));
    JsonNode body = mapper.readTree(wire.getAllServeEvents().get(0).getRequest().getBodyAsString());
    JsonNode itemType = body.at("/jsonSchema/schema/properties/slots/properties/item_type");
    assertThat(itemType.get("type").asText()).isEqualTo("string"); // не ["string","null"]
    assertThat(itemType.get("enum")).hasSize(3); // без null
    assertThat(itemType.has("maxLength")).isFalse();
    assertThat(body.at("/jsonSchema/schema/properties/confidence").has("minimum")).isFalse();
  }

  @Test
  void badRequestFallsBackToJsonObjectAndRemembersIt() throws Exception {
    wire.stubFor(
        post(urlEqualTo(PATH))
            .atPriority(1)
            .withRequestBody(matchingJsonPath("$.jsonSchema"))
            .willReturn(aResponse().withStatus(400).withBody("{\"error\":\"schema is not supported\"}")));
    wire.stubFor(post(urlEqualTo(PATH)).atPriority(5).willReturn(okJson(OK)));
    var client = client("k", "f", 5);

    assertThat(client.generateStructuredJson("sys", "data")).isEqualTo("{\"intent\":\"unknown\"}");
    wire.verify(2, postRequestedFor(urlEqualTo(PATH)));
    wire.verify(1, postRequestedFor(urlEqualTo(PATH)).withRequestBody(matchingJsonPath("$.jsonObject", equalTo("true"))));

    client.generateStructuredJson("sys", "data"); // режим запомнен: сразу jsonObject
    wire.verify(3, postRequestedFor(urlEqualTo(PATH)));
  }

  @Test
  void badRequestEverywhereEndsAsLlmUnavailable() throws Exception {
    wire.stubFor(post(urlEqualTo(PATH)).willReturn(aResponse().withStatus(400).withBody("{}")));
    assertThatThrownBy(() -> client("k", "f", 5).generateStructuredJson("sys", "data"))
        .isInstanceOfSatisfying(
            AppException.class, e -> assertThat(e.getCode()).isEqualTo(ErrorCode.LLM_UNAVAILABLE));
    wire.verify(3, postRequestedFor(urlEqualTo(PATH))); // jsonSchema → jsonObject → обычный
  }

  @Test
  void gatewayTimeoutStatusMapsToTimeout() throws Exception {
    wire.stubFor(post(urlEqualTo(PATH)).willReturn(aResponse().withStatus(504)));
    assertThatThrownBy(() -> client("k", "f", 5).generateStructuredJson("sys", "data"))
        .isInstanceOfSatisfying(
            AppException.class, e -> assertThat(e.getCode()).isEqualTo(ErrorCode.LLM_TIMEOUT));
    wire.verify(1, postRequestedFor(urlEqualTo(PATH)));
  }

  @Test
  void authErrorIsNotRetried() throws Exception {
    wire.stubFor(post(urlEqualTo(PATH)).willReturn(aResponse().withStatus(401)));
    assertThatThrownBy(() -> client("bad", "f", 5).generateStructuredJson("sys", "data"))
        .isInstanceOfSatisfying(
            AppException.class, e -> assertThat(e.getCode()).isEqualTo(ErrorCode.LLM_UNAVAILABLE));
    wire.verify(1, postRequestedFor(urlEqualTo(PATH)));
  }

  @Test
  void incompleteAnswerIsReturnedAsEmptyString() throws Exception {
    wire.stubFor(
        post(urlEqualTo(PATH))
            .willReturn(
                okJson(
                    "{\"result\":{\"alternatives\":[{\"message\":{\"role\":\"assistant\",\"text\":\"{\\\"int\"},"
                        + "\"status\":\"ALTERNATIVE_STATUS_TRUNCATED_FINAL\"}]}}")));
    assertThat(client("k", "f", 5).generateStructuredJson("sys", "data")).isEmpty();
  }

  @Test
  void missingCredentialsNeverCallProvider() throws Exception {
    assertThatThrownBy(() -> client("", "", 5).generateStructuredJson("sys", "data"))
        .isInstanceOfSatisfying(
            AppException.class, e -> assertThat(e.getCode()).isEqualTo(ErrorCode.LLM_UNAVAILABLE));
    assertThat(wire.getAllServeEvents()).isEmpty();
  }
}
</file>

<file path="src/test/java/com/example/agend_ai/service/DateResolverExtendedTest.java">
package com.example.agend_ai.service;

import static org.assertj.core.api.Assertions.*;

import java.time.*;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.*;

/** Дополнительные случаи DateResolver. «Сейчас»: пятница, 23.10.2026, 14:02:47 (Europe/Moscow). */
class DateResolverExtendedTest {
  private static final ZoneId MSK = ZoneId.of("Europe/Moscow");
  private static final Instant NOW = Instant.parse("2026-10-23T11:02:47Z");
  private final DateResolver resolver = new DateResolver(Clock.fixed(NOW, ZoneOffset.UTC));

  @ParameterizedTest
  @CsvSource(
      delimiter = '|',
      value = {
        // предлоги и знаки препинания
        "на завтра|10:00|2026-10-24T07:00:00Z",
        "на сегодня|15:00|2026-10-23T12:00:00Z",
        "завтра.|10:00|2026-10-24T07:00:00Z",
        // дни недели: «до», «к», «следующая»
        "до четверга|10:00|2026-10-29T07:00:00Z",
        "к четвергу|10:00|2026-10-29T07:00:00Z",
        "следующая пятница|10:00|2026-10-30T07:00:00Z",
        "в эту пятницу|23:00|2026-10-23T20:00:00Z",
        // календарные даты
        "30 октября|11:00|2026-10-30T08:00:00Z",
        "30.10|11:00|2026-10-30T08:00:00Z",
        "30.10.2026|11:00|2026-10-30T08:00:00Z",
        "5 ноября 2027|11:00|2027-11-05T08:00:00Z",
        "3 января|10:00|2027-01-03T07:00:00Z",
        // «через N дней/недель»
        "через три дня|10:00|2026-10-26T07:00:00Z",
        "через неделю|10:00|2026-10-30T07:00:00Z",
        "через 2 недели|10:00|2026-11-06T07:00:00Z",
        // ISO без смещения — в часовом поясе пользователя
        "2026-10-24T15:00:00||2026-10-24T12:00:00Z",
        // время словами и с «часов»
        "завтра|в пятнадцать|2026-10-24T12:00:00Z",
        "завтра|в три тридцать|2026-10-24T12:30:00Z",
        "завтра|в десять сорок пять|2026-10-24T07:45:00Z",
        "завтра|в три часа дня|2026-10-24T12:00:00Z",
        "завтра|10 часов утра|2026-10-24T07:00:00Z",
        "завтра|в двадцать один|2026-10-24T18:00:00Z",
        // «3:30» без утра/вечера — дневное время, «03:30» — буквально
        "завтра|3:30|2026-10-24T12:30:00Z",
        "завтра|07:30|2026-10-24T04:30:00Z",
        "завтра|на 17|2026-10-24T14:00:00Z",
        "завтра|в 17.|2026-10-24T14:00:00Z"
      })
  void resolvesNewPhrases(String date, String time, String expected) {
    var result = resolver.resolve(date, time, MSK, null);
    assertThat(result.startAt()).isEqualTo(Instant.parse(expected));
    assertThat(result.needsDateClarification()).isFalse();
    assertThat(result.needsTimeClarification()).isFalse();
  }

  @ParameterizedTest
  @CsvSource(
      delimiter = '|',
      value = {
        "через час|2026-10-23T12:02:00Z",
        "через полчаса|2026-10-23T11:32:00Z",
        "через пять минут|2026-10-23T11:07:00Z",
        "через пятнадцать минут|2026-10-23T11:17:00Z",
        "через двадцать пять минут|2026-10-23T11:27:00Z",
        "через четыре часа|2026-10-23T15:02:00Z",
        "через 2 часа 15 минут|2026-10-23T13:17:00Z",
        "через полтора часа|2026-10-23T12:32:00Z"
      })
  void relativeTimeVariants(String time, String expected) {
    var result = resolver.resolve(null, time, MSK, null);
    assertThat(result.startAt()).isEqualTo(Instant.parse(expected));
    assertThat(result.needsDateClarification()).isFalse();
  }

  @ParameterizedTest
  @CsvSource(
      delimiter = '|',
      value = {
        "до пятницы|ambiguous_date",
        "12 октября|past",
        "31 февраля|invalid_date",
        "на этой неделе|missing_day",
        "через абракадабру|invalid_date",
        "через 0 минут|invalid_date"
      })
  void stillAsksWhenUnsure(String expr, String reason) {
    var result = resolver.resolve(expr.startsWith("через") ? null : expr, expr.startsWith("через") ? expr : "10:00", MSK, null);
    assertThat(result.reason()).isEqualTo(reason);
  }

  @ParameterizedTest
  @ValueSource(strings = {"к концу недели", "до конца этой недели", "конец недели"})
  void endOfWeekPhrases(String expr) {
    assertThat(resolver.resolve(expr, null, MSK, null).dueAt())
        .isEqualTo(Instant.parse("2026-10-25T20:59:00Z"));
  }

  @Test
  void localIsoTimestampInDstGapAsks() {
    assertThat(resolver.resolve("2027-03-28T02:30:00", null, ZoneId.of("Europe/Berlin"), null).reason())
        .isEqualTo("ambiguous_time");
  }

  @ParameterizedTest
  @CsvSource(
      delimiter = '|',
      value = {
        "на сегодня|2026-10-23|2026-10-23",
        "на завтра|2026-10-24|2026-10-24",
        "в субботу|2026-10-24|2026-10-24",
        "эта неделя|2026-10-23|2026-10-25",
        "на эту неделю|2026-10-23|2026-10-25",
        "следующая неделя|2026-10-26|2026-11-01",
        "на следующую неделю|2026-10-26|2026-11-01",
        "30 октября|2026-10-30|2026-10-30",
        "2026-10-24 по 2026-10-27|2026-10-24|2026-10-27"
      })
  void periodPhrases(String expr, String first, String last) {
    var p = resolver.period(expr, MSK);
    assertThat(p.first()).isEqualTo(LocalDate.parse(first));
    assertThat(p.last()).isEqualTo(LocalDate.parse(last));
  }
}
