# Database
DB_USER=
DB_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=

# Encryption
# Base64-encoded 32 random bytes.
# IMPORTANT: do not change this value in .env if the database already contains encrypted data.
DATA_ENCRYPTION_KEY=

# Authentication
# Base64-encoded 32+ random bytes. Must be different from DATA_ENCRYPTION_KEY.
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=

# LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_FOLDER_ID=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SEC=
LLM_MAX_TOKENS=

# Speech-to-Text
STT_PROVIDER=
STT_API_KEY=

# Web Push
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=